{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "esModuleInterop": true,
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "server",
    "shared"
  ]
}
