{
  "name": "seam",
  "version": "1.0.0",
  "private": true,
  "description": "Maison Neuf Seam: an ad-free number-puzzle house",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --jsx=automatic --jsx-import-source=preact --external:/fonts/* --outdir=dist/client --entry-names=app",
    "build:static": "mkdir -p dist/client/fonts && cp src/client/index.html dist/client/index.html && cp fonts/*.woff2 dist/client/fonts/",
    "build": "npm run typecheck && npm run build:server && npm run build:client && npm run build:static",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "preact": "10.29.8",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
