{
  "name": "linewell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "lucide": "0.546.0",
    "pg": "8.16.3",
    "preact": "10.29.8",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.js && esbuild src/client/main.tsx --bundle --format=esm --minify --target=es2022 --jsx=automatic --jsx-import-source=preact --external:/fonts/* --outfile=dist/client/app.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  }
}
