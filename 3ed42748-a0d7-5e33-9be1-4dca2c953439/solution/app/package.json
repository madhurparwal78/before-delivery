{
  "name": "parcel-moon",
  "version": "1.0.0",
  "private": true,
  "description": "Kitefold Parcel Moon: a small courier game on the planet Bramble.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist/server.cjs --log-level=warning",
    "build:game": "esbuild src/client/game/main.ts --bundle --format=esm --target=es2022 --minify --loader:.woff2=file --asset-names=fonts/[name]-[hash] --log-level=warning --outfile=dist/client/game.js",
    "build:console": "esbuild src/client/console/main.ts --bundle --format=esm --target=es2022 --minify --loader:.woff2=file --asset-names=fonts/[name]-[hash] --log-level=warning --outfile=dist/client/console.js",
    "build:claim": "esbuild src/client/claim/main.ts --bundle --format=esm --target=es2022 --minify --loader:.woff2=file --asset-names=fonts/[name]-[hash] --log-level=warning --outfile=dist/client/claim.js",
    "build:share": "esbuild src/client/styles/share.css --bundle --format=esm --target=es2022 --minify --loader:.woff2=file --asset-names=fonts/[name]-[hash] --log-level=warning --outfile=dist/client/share.css",
    "build": "npm run -s typecheck && npm run -s build:server && npm run -s build:game && npm run -s build:console && npm run -s build:claim && npm run -s build:share",
    "start": "node dist/server.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "three": "0.186.1",
    "typescript": "5.9.3"
  }
}
