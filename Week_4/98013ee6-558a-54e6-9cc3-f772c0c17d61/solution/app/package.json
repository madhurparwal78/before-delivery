{
  "name": "mothlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mothlight: a visual bookmarking site for collectors.",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json --noEmit && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@fastify/busboy": "3.2.5",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
