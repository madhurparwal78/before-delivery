{% extends "layout.njk" %}
{% from "macros.njk" import display %}
{% block content %}
<header class="page-head">
  {{ display('Fleet', ['Fleet']) }}
</header>
{% include "partials/fleet_summary.njk" %}
<table class="table table-cards table-fleet">
  <caption class="sr-only">The fleet, ordered by truck</caption>
  <thead>
    <tr>
      <th scope="col">Truck</th>
      <th scope="col">Depot</th>
      <th scope="col">Status</th>
      <th scope="col">Request</th>
      {% if can.admin %}<th scope="col">Maintenance</th>{% endif %}
    </tr>
  </thead>
  <tbody>
  {% for truck in trucks %}{% include "partials/truck_row.njk" %}{% endfor %}
  </tbody>
</table>
{% endblock %}
