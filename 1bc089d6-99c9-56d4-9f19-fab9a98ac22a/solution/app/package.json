{
  "name": "stillhour",
  "version": "1.0.0",
  "private": true,
  "description": "Stillhour: a cinematic scroll story of the hour before sleep, and a wind-down planner with nightly reminders.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --log-level=warning --outfile=dist/server/main.mjs",
    "start": "node --enable-source-maps dist/server/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "lenis": "1.3.13",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
