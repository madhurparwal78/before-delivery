{
  "name": "hushline",
  "version": "1.0.0",
  "private": true,
  "description": "Hushline: a support messenger for a solo game developer",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/main.js"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
