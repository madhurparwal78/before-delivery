{%- macro icon(name, cls='') -%}
<svg class="icon {{ cls }}" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#i-{{ name }}"></use></svg>
{%- endmacro -%}

{#- A display headline: the sentence once for assistive technology, then the
    lines that rise one after another, hidden from it. -#}
{%- macro display(text, lines, tag='h1', cls='') -%}
<{{ tag }} class="display {{ cls }}"><span class="sr-only">{{ text }}</span><span class="display-lines" aria-hidden="true">
{%- for l in lines %}<span class="line"><span class="line-in" style="--i: {{ loop.index0 }}">{{ l }}</span></span>{% endfor -%}
</span></{{ tag }}>
{%- endmacro -%}

{%- macro label(text) -%}
<span class="roll"><span class="roll-in"><span>{{ text }}</span><span aria-hidden="true">{{ text }}</span></span></span>
{%- endmacro -%}

{%- macro chip(status) -%}
<span class="chip chip-{{ status }}"><span class="dot" aria-hidden="true"></span>{{ LABELS.status[status] }}</span>
{%- endmacro -%}

{%- macro field_error(errors, key, id) -%}
{%- if errors[key] %}<p class="field-error" id="{{ id }}-error">{{ icon('cross') }}<span>{{ errors[key] }}</span></p>{% endif -%}
{%- endmacro -%}

{%- macro err_attrs(errors, key, id) -%}
{%- if errors[key] %} aria-invalid="true" aria-describedby="{{ id }}-error"{% endif -%}
{%- endmacro -%}

{%- macro notice_line(text, problem) -%}
<p class="notice{% if problem %} notice-problem{% endif %}">{{ icon('cross' if problem else 'check') }}<span>{{ text }}</span></p>
{%- endmacro -%}

{#- A numbered stop card: its date or No date, then the full address. -#}
{%- macro stop_card(number, kind, s) -%}
<li class="stop-card" data-stop-kind="{{ kind }}">
  <h3 class="stop-title">( {{ number }} ) {{ LABELS.stop[kind] }}</h3>
  <p class="stop-date">{{ (s.date | day) or 'No date' }}</p>
  <p class="wrap">{{ s.address }}<br>{{ s.city }}, <span class="keep">{{ s.region }} {{ s.postal_code }}</span><br>{{ s.country }}</p>
</li>
{%- endmacro -%}

{%- macro lockup() -%}
<span class="lockup"><span>Gigfreight</span><span>Entertainment</span><span>Logistic.</span></span>
{%- endmacro -%}

{%- macro logo() -%}
<span class="logo" aria-hidden="true"><span class="logo-box"><span>Gig</span><span>freight</span></span></span>
{%- endmacro -%}

