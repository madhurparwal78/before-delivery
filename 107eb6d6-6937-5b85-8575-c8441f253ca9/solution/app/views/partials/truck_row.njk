{%- from "macros.njk" import icon, label -%}
<tr id="truck-{{ truck.id }}" data-truck-id="{{ truck.id }}" data-truck-status="{{ truck.status }}" data-request-id="{{ truck.request_id or '' }}">
  <td data-label="Truck"><span class="truck-cell">{{ icon('truck', 'icon-lg') }}<span class="mono">{{ truck.id }}</span></span></td>
  <td data-label="Depot">{{ LABELS.depot[truck.depot] }}</td>
  <td data-label="Status"><span class="chip chip-truck chip-{{ truck.status }}"><span class="dot" aria-hidden="true"></span>{{ LABELS.truck[truck.status] }}</span></td>
  <td data-label="Request">{% if truck.request_id %}<a href="/requests/{{ truck.request_id }}" class="mono link-out">{{ truck.request_id }}{{ icon('external') }}</a>{% else %}<span class="muted">None</span>{% endif %}</td>
  {% if can.admin %}
  <td data-label="Maintenance" class="cell-action">
    {% if truck.status == 'assigned' %}
    <span class="caption muted">On a request</span>
    {% else %}
    {% set start = truck.status == 'available' %}
    <button type="button" id="maintenance-{{ truck.id }}" class="btn btn-secondary btn-small" data-busy="Saving..."
            hx-patch="/fleet/{{ truck.id }}" hx-vals='{"status": "{{ 'maintenance' if start else 'available' }}"}'
            hx-target="closest tr" aria-describedby="truck-{{ truck.id }}-name">{{ label('Start maintenance' if start else 'End maintenance') }}</button>
    <span class="sr-only" id="truck-{{ truck.id }}-name">{{ truck.id }}</span>
    {% endif %}
  </td>
  {% endif %}
</tr>
