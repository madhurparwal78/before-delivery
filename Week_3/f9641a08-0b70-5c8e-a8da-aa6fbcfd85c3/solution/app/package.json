{
  "name": "roam-house-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Roam House Atelier: storefront and operations dashboard on one TypeScript server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --external:pg-native --loader:.sql=text --log-level=error",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node dist/server.cjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.919.0",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "meilisearch": "0.54.0",
    "nodemailer": "7.0.10",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
