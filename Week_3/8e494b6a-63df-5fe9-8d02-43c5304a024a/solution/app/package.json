{
  "name": "spoorline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spoorline: a log search and observability console",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --format=esm --outdir=dist/public --entry-names=app --loader:.woff2=file --asset-names=assets/[name]-[hash]",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
