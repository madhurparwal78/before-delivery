{%- from "macros.njk" import icon, label, lockup, logo, notice_line -%}
<!doctype html>
<html lang="en"{% if reduceMotion %} class="reduce-motion"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | Gigfreight</title>
<meta name="description" content="Gigfreight dispatch desk: trucks for touring shows.">
<meta name="htmx-config" content='{"historyCacheSize":0,"refreshOnHistoryMiss":true,"includeIndicatorStyles":false,"allowEval":false,"defaultSwapStyle":"outerHTML","defaultSettleDelay":0,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"4..","swap":true,"error":false},{"code":"...","swap":false,"error":true}]}'>
<script>
/* Use the system's narrow sans for display type when it exists; otherwise draw the
   regular face condensed. Runs before first paint so nothing shifts. */
(function () {
  try {
    var c = document.createElement('canvas').getContext('2d');
    var probe = 'MWMWMWMWMW';
    c.font = '900 64px monospace'; var mono = c.measureText(probe).width;
    c.font = '900 64px "Arial Narrow", "Liberation Sans Narrow", "Nimbus Sans Narrow", "DejaVu Sans Condensed", "Roboto Condensed", monospace'; var narrow = c.measureText(probe).width;
    if (Math.abs(mono - narrow) < 0.5) document.documentElement.classList.add('no-narrow');
  } catch (e) { document.documentElement.classList.add('no-narrow'); }
}());
</script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%234e37ff'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='Arial' font-weight='900' font-size='15' fill='%23fefefe'%3EGF%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="{{ asset('app.css') }}">
<script src="{{ asset('vendor/htmx.min.js') }}" defer></script>
<script src="{{ asset('app.js') }}" defer></script>
</head>
<body class="{{ 'signed-in' if member else 'signed-out' }}">
{% include "partials/icons.njk" %}
<a class="skip-link" href="#main">Skip to content</a>
{% if member %}
<div class="shell">
  <header class="sidebar">
    <div class="sidebar-top">
      <a class="lockup-link" href="/requests">{{ lockup() }}{{ logo() }}</a>
      <button type="button" class="btn btn-secondary menu-button" aria-expanded="false" aria-controls="site-nav" data-menu>{{ icon('menu') }}<span>Menu</span></button>
    </div>
    <div class="sidebar-body" id="site-nav">
      <nav aria-label="Desk">
        <ul class="nav">
          <li><a href="/requests"{% if path.startsWith('/requests') %} aria-current="page"{% endif %}>Requests</a></li>
          {% if can.dispatch %}
          <li><a href="/dispatch"{% if path == '/dispatch' %} aria-current="page"{% endif %}>Dispatch</a></li>
          <li><a href="/fleet"{% if path == '/fleet' %} aria-current="page"{% endif %}>Fleet</a></li>
          {% endif %}
          {% if can.admin %}
          <li><a href="/admin/users"{% if path == '/admin/users' %} aria-current="page"{% endif %}>Members</a></li>
          {% endif %}
        </ul>
      </nav>
      <div class="sidebar-foot">
        <p class="who"><span class="who-name">{{ member.name }}</span> <span class="badge">{{ LABELS.role[member.role] }}</span></p>
        <button type="button" class="switch" aria-pressed="{{ 'true' if reduceMotion else 'false' }}" data-reduce-motion><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span class="switch-label">Reduce motion</span></button>
        <form method="post" action="/logout" class="signout">
          <button type="submit" class="btn btn-secondary">{{ label('Sign out') }}</button>
        </form>
      </div>
    </div>
    <div id="notices" class="notices" role="status" aria-live="polite" aria-label="Desk notices">{% if notice %}{{ notice_line(notice, problem) }}{% endif %}</div>
  </header>
{% endif %}
  <div class="work">
    <main id="main" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
    {% include "partials/band.njk" %}
  </div>
{% if member %}
</div>
{% endif %}
</body>
</html>
