    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/pg": "8.15.2",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  }
}
