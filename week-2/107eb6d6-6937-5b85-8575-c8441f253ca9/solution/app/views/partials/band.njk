<footer class="band">
  <div class="rail" aria-hidden="true">
    <div class="rail-track">
      {%- for n in range(0, 2) %}
      <div class="rail-set">
        {%- for k in range(0, 6) %}<span class="rail-item"><span class="rail-its">It's a</span> <span class="rail-name">Gigfreight</span> <span class="rail-tour">Tour</span></span>{% endfor -%}
      </div>
      {%- endfor %}
    </div>
  </div>
  <p class="sr-only">It's a Gigfreight Tour</p>
  <div class="depots">
    <section class="depot" aria-labelledby="depot-north">
      <h2 id="depot-north" class="depot-name">North depot</h2>
      <p class="depot-line">555-555-5555</p>
    </section>
    <section class="depot" aria-labelledby="depot-south">
      <h2 id="depot-south" class="depot-name">South depot</h2>
      <p class="depot-line">555-555-5555</p>
    </section>
  </div>
  <p class="band-line">Move. Get your gear moving. Safe and on point.</p>
</footer>
