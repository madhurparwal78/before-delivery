{
  "name": "oakgall-quire",
  "version": "1.0.0",
  "private": true,
  "description": "Oakgall Press Quire: a personal commonplace workspace.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx src/client/share.tsx --bundle --minify --target=es2022 --format=esm --outdir=dist/public --entry-names=[name] --jsx=automatic --external:/fonts/* --define:process.env.NODE_ENV=\\\"production\\\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
