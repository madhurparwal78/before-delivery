{% extends "layout.njk" %}
{% from "macros.njk" import display %}
{% block content %}
<header class="page-head">
  {{ display('Members', ['Members']) }}
</header>
<table class="table table-cards">
  <caption class="sr-only">Members and their roles</caption>
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Email</th>
      <th scope="col">Role</th>
    </tr>
  </thead>
  <tbody>
  {% for m in members %}{% include "partials/member_row.njk" %}{% endfor %}
  </tbody>
</table>
{% endblock %}
