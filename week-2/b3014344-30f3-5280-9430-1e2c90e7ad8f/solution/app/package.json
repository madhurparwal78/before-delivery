{
  "name": "pampero-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pampero Build Co. storefront and client ledger",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:client": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server/main.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
