{% extends "layout.njk" %}
{% from "macros.njk" import display, icon, label, lockup, logo, truck_art %}
{% block content %}
<div class="signin">
  <div class="signin-top">
    {{ lockup() }}
    {{ logo() }}
  </div>
  <div class="signin-grid">
    <div class="signin-hero">
      {{ display("Let's move your next show.", ["Let's move", "your next", "show."], 'h1', 'display-hero') }}
      {{ truck_art('well-signin') }}
    </div>
    <section class="signin-panel" aria-labelledby="signin-heading">
      <h2 id="signin-heading" class="section-title">Sign in to Gigfreight</h2>
      <p class="muted">Fill in your details, we will take it from there.</p>
      <form method="post" action="/login" class="form" novalidate data-busy-form>
        <input type="hidden" name="next" value="{{ next }}">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" spellcheck="false" value="{{ email }}">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password">
        </div>
        {% if failure %}<p class="form-error" role="alert" aria-label="Sign-in error">{{ icon('cross') }}<span>{{ failure }}</span></p>{% endif %}
        <button type="submit" class="btn btn-primary btn-block">{{ label('Sign in') }}{{ icon('arrow') }}</button>
        <p class="caption muted">Demo accounts: admin, dispatcher, manager and milo at example.com, password deku-demo-pw-2026</p>
      </form>
    </section>
  </div>
</div>
{% endblock %}
