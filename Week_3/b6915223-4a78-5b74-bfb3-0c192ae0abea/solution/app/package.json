{
  "name": "elevens",
  "version": "1.0.0",
  "private": true,
  "description": "Sideline Works Elevens — fantasy football for a ten-club league",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --jsx=automatic --jsx-import-source=preact --outfile=dist/client/assets/app.js --loader:.woff2=file --asset-names=fonts/[name] --public-path=/assets",
    "build:static": "cp public/index.html dist/client/index.html",
    "build": "npm run typecheck && rm -rf dist && npm run build:server && npm run build:client && npm run build:static",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "preact": "11.1.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
