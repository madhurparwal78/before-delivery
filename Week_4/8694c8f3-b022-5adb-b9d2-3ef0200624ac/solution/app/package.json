{
  "name": "afterglass",
  "version": "1.0.0",
  "private": true,
  "description": "Quillbeam Works Afterglass: a browser studio for beat-locked 3D shader sets",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server/main.mjs",
    "start": "node dist/server/main.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "lucide-react": "1.68.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
