{
  "name": "roundbook",
  "version": "1.0.0",
  "private": true,
  "description": "Roundbook: the day-to-day workspace for a small-animal clinic",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "nodemailer": "10.5.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "pako": "0.2.9"
  }
}
