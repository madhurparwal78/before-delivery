{
  "name": "brackenpad",
  "version": "1.0.0",
  "private": true,
  "description": "Brackenpad: a small hosted notebook service by Wrenmoor Software.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node build/server.js"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "katex": "0.19.1",
    "lucide-react": "1.69.0",
    "marked": "18.1.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
