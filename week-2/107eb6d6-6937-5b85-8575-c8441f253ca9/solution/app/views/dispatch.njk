{% extends "layout.njk" %}
{% from "macros.njk" import display, truck_art %}
{% block content %}
<header class="page-head">
  {{ display('Dispatch', ['Dispatch']) }}
</header>
{% set s = board.summary %}
<p class="summary" data-waiting="{{ s.waiting }}" data-trucks-needed="{{ s.trucks_needed }}" data-trucks-available="{{ s.trucks_available }}"><span class="stat-group"><span class="stat">{{ s.waiting }}</span> waiting,</span> <span class="stat-group"><span class="stat">{{ s.trucks_needed }}</span> {{ 'truck' if s.trucks_needed == 1 else 'trucks' }} needed,</span> <span class="stat-group"><span class="stat">{{ s.trucks_available }}</span> {{ 'truck' if s.trucks_available == 1 else 'trucks' }} available</span></p>
{% if board.requests.length %}
<table class="table table-cards">
  <caption class="sr-only">Submitted requests waiting for trucks, oldest first</caption>
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Tour</th>
      <th scope="col">Requester</th>
      <th scope="col">Type</th>
      <th scope="col">Trucks</th>
      <th scope="col">First show</th>
      <th scope="col">Submitted</th>
    </tr>
  </thead>
  <tbody>
  {% for r in board.requests %}
    <tr data-request-id="{{ r.id }}" data-status="{{ r.status }}">
      <td data-label="ID" class="mono">{{ r.id }}</td>
      <td data-label="Tour" class="cell-tour"><a href="/requests/{{ r.id }}" title="{{ r.tour_name }}">{{ r.tour_name }}</a></td>
      <td data-label="Requester" class="cell-nowrap">{{ r.requester.name }}</td>
      <td data-label="Type">{{ LABELS.type[r.transport_type] }}</td>
      <td data-label="Trucks">{{ r.trucks_assigned }} of {{ r.trucks_requested }}</td>
      <td data-label="First show">{{ (r.first_show_date | day) or 'No date' }}</td>
      <td data-label="Submitted">{{ r.created_at | day }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<div class="empty">
  {{ truck_art('well-empty') }}
  <div class="empty-copy"><p class="list-text">Nothing waiting. Every submitted request has been decided.</p></div>
</div>
{% endif %}
{% endblock %}
