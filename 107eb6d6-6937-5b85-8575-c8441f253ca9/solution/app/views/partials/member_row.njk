{%- from "macros.njk" import label -%}
<tr id="member-{{ m.id }}" data-member-id="{{ m.id }}">
  <td data-label="Name" id="member-{{ m.id }}-name">{{ m.name }}</td>
  <td data-label="Email" class="wrap">{{ m.email }}</td>
  <td data-label="Role">
    <form class="role-form" novalidate hx-patch="/admin/users/{{ m.id }}" hx-target="closest tr">
      <label class="sr-only" for="role-{{ m.id }}">Role for {{ m.name }}</label>
      <select id="role-{{ m.id }}" name="role">
        {% for value, word in LABELS.role %}
        <option value="{{ value }}"{% if m.role == value %} selected{% endif %}>{{ word }}</option>
        {% endfor %}
      </select>
      <button type="submit" id="save-{{ m.id }}" class="btn btn-secondary btn-small" data-busy="Saving..." aria-describedby="member-{{ m.id }}-name">{{ label('Save') }}</button>
    </form>
  </td>
</tr>
