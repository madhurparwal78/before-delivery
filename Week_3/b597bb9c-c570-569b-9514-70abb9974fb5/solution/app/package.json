{
  "name": "gatecut",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/index.ts",
  "description": "Gatecut, a browser editor for freelance video editors who cut for agency teams.",
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "notices": "node scripts/notices.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "amqplib": "2.2.1",
    "ioredis": "6.0.0",
    "lucide-react": "1.69.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
