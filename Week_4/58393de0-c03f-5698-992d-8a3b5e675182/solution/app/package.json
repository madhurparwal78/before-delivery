{
  "name": "quarkyard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hollowbrook Maker Co. Quarkyard: a browser maker studio for after-school STEM classes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "test": "vitest run",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@fontsource/fira-sans": "5.3.0",
    "lucide-react": "1.70.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
