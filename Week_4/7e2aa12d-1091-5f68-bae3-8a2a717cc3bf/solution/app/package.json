{
  "name": "mullion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mullion: a hosted visual editor for CSS grid layouts",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ioredis": "5.4.2",
    "pg": "8.13.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  }
}
