{
  "name": "keyway-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keyway Bench: a browser 3D bench for escape-room owners",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/server/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
