{% extends "layout.njk" %}
{% from "macros.njk" import display, icon, label %}
{% block content %}
<section class="message-page">
  {{ display(headline, headline | lines(12)) }}
  <p class="lede">{{ line }}</p>
  <p><a class="btn btn-primary" href="/requests">{{ label('Back to requests') }}{{ icon('arrow') }}</a></p>
</section>
{% endblock %}
