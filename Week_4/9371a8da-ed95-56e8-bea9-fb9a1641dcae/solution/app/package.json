{
  "name": "marginalia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quillwork Labs Marginalia: shared LaTeX writing desk with tracked review",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --jsx=automatic --jsx-import-source=preact --outfile=dist/public/app.js --loader:.woff2=file --asset-names=fonts/[name]",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "preact": "10.29.8",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
