{
  "name": "oxbow-assembly-rushes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=chrome120,firefox120,safari17 --jsx=automatic --loader:.woff2=file --loader:.woff=file --asset-names=[name]-[hash] --entry-names=[name] --define:process.env.NODE_ENV='\"production\"' --outdir=dist/client/assets",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
