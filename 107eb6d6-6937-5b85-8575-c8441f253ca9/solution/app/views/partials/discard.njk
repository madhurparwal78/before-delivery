{%- from "macros.njk" import label -%}
<dialog class="dialog" id="discard-dialog" aria-labelledby="discard-title" aria-describedby="discard-line">
  <h2 id="discard-title" class="section-title">Discard this request?</h2>
  <p class="muted" id="discard-line">What you typed for this request will be cleared.</p>
  <div class="actions">
    <button type="button" class="btn btn-danger" hx-delete="/requests/new" hx-swap="none">{{ label('Discard') }}</button>
    <button type="button" class="btn btn-secondary" data-close-dialog autofocus>{{ label('Keep editing') }}</button>
  </div>
</dialog>
