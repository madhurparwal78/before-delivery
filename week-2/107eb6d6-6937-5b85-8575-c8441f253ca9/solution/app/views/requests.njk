{% extends "layout.njk" %}
{% from "macros.njk" import display, icon, label %}
{% block content %}
<header class="page-head">
  {{ display('Requests', ['Requests']) }}
  {% if not can.dispatch %}
  <a class="btn btn-primary" href="/requests/new">{{ icon('plus') }}{{ label('New request') }}</a>
  {% endif %}
</header>
<form class="filters" action="/requests" method="get" role="search" aria-label="Requests" data-drop-empty
      hx-get="/requests" hx-target="#request-results" hx-swap="outerHTML" hx-push-url="true"
      hx-trigger="input changed delay:300ms from:#q, search from:#q, change from:#status, submit">
  <div class="field field-search">
    <label for="q">Search requests</label>
    <input id="q" name="q" type="search" value="{{ q }}" autocomplete="off" spellcheck="false">
  </div>
  <div class="field field-status">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value=""{% if not status %} selected{% endif %}>All statuses</option>
      {% for value, word in LABELS.status %}
      <option value="{{ value }}"{% if status == value %} selected{% endif %}>{{ word }}</option>
      {% endfor %}
    </select>
  </div>
</form>
{% include "partials/request_results.njk" %}
{% endblock %}
