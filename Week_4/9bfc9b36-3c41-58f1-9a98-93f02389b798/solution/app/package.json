{
  "name": "boltrope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boltrope: a loft workbench for one sailmaker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.24.0",
    "typescript": "5.7.2"
  }
}
