{
  "name": "lowfield-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:client": "esbuild src/client/main.ts --bundle --minify --target=es2022 --format=esm --loader:.woff2=file --asset-names=fonts/[name] --outfile=dist/public/assets/app.js",
    "build": "npm run typecheck && npm run build:server && npm run build:client && npm run build:html",
    "start": "node dist/server.mjs",
    "build:html": "node -e \"require('node:fs').copyFileSync('src/client/index.html','dist/public/index.html')\""
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
