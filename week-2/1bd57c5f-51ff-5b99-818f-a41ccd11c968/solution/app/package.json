{
  "name": "snaglight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plumb & Pencil Snaglight: punch lists, job notes and house access for small remodelers.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "build": "npm run typecheck && vite build && esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "aws4fetch": "1.0.20",
    "lucide-react": "1.66.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
