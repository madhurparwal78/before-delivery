{
  "name": "moothall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Moothall: communities, posts, votes and live threads with public moderation.",
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@node-rs/argon2": "2.2.2",
    "ioredis": "5.11.1",
    "marked": "16.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json && esbuild src/client/main.tsx --bundle --minify --format=esm --target=es2022 --outdir=dist/client --entry-names=main --external:/fonts/* --jsx=automatic",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}
