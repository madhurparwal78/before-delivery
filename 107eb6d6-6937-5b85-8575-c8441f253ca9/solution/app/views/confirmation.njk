{% extends "layout.njk" %}
{% from "macros.njk" import display, icon, label, chip %}
{% block content %}
<section class="confirmation">
  {{ display(headline, headline | lines(9), 'h1', 'display-confirm') }}
  <div class="confirmation-body">
    <p class="confirmation-id mono">{{ request.id }}</p>
    <p class="list-text"><span class="wrap">{{ request.tour_name }}</span> {{ chip(request.status) }}</p>
    <p class="lede">{% if request.status == 'submitted' %}{{ request.id }} is on the Dispatch board for {{ request.trucks_requested | trucks('to fill') }}.{% else %}{{ request.id }} is now {{ LABELS.status[request.status] }}.{% endif %}</p>
    <p><a class="btn btn-primary" href="/requests/{{ request.id }}">{{ label('View request') }}{{ icon('arrow') }}</a></p>
  </div>
</section>
{% endblock %}
