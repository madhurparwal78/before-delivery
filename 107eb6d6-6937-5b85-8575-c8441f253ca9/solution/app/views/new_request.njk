{% extends "layout.njk" %}
{% from "macros.njk" import display %}
{% block content %}
<header class="page-head">
  {{ display('New request', ['New', 'request']) }}
</header>
{% set steps = [['Tour details', '/requests/new'], ['Stops', '/requests/new/stops'], ['Review', '/requests/new/review']] %}
<ol class="steps" aria-label="New request steps">
  {% for s in steps %}
  <li class="step{% if loop.index == step %} is-current{% elif loop.index < step %} is-done{% else %} is-later{% endif %}"{% if loop.index == step %} aria-current="step"{% endif %}>
    <span class="step-num">( {{ loop.index }} )</span> <span class="step-name">{{ s[0] }}</span>
  </li>
  {% endfor %}
</ol>
{% include "partials/step_form.njk" %}
{% include "partials/discard.njk" %}
{% endblock %}
