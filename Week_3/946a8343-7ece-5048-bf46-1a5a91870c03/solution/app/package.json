{
  "name": "spurline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spurline: a self-contained code forge in the browser",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "build": "npm run typecheck && node build.mjs",
    "start": "node dist/server.js",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "preact": "10.29.8",
    "typescript": "5.9.3"
  }
}
