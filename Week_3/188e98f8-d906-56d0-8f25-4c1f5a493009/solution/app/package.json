{
  "name": "roundkeeper",
  "version": "1.0.0",
  "private": true,
  "description": "Snugbar Works Roundkeeper: the answer desk for a weekly pub quiz league",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "exports": {
    "./server": "./src/server/main.ts",
    "./client": "./src/client/main.tsx"
  }
}
