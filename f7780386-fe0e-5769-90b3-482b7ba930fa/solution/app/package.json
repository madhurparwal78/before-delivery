{
  "name": "passboard",
  "version": "1.0.0",
  "private": true,
  "description": "Pilotlight Works Passboard: booking, compliance and billing desk for a shared-use commercial kitchen",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server/main.cjs --external:pg-native --legal-comments=none",
    "build:web": "esbuild src/web/main.tsx --bundle --minify --format=esm --target=es2022 --outdir=dist/web --entry-names=app --jsx=automatic --jsx-import-source=preact --legal-comments=none --external:/fonts/*",
    "start": "node dist/server/main.cjs"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "busboy": "1.6.0",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "preact": "10.27.2",
    "typescript": "5.9.3"
  }
}
