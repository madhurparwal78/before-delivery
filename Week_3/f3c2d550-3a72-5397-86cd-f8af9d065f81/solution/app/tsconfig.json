{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts", "web/src/**/*.ts", "web/src/**/*.tsx"]
}
