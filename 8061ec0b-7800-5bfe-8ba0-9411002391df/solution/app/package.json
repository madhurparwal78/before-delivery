{
  "name": "bellroll",
  "version": "1.0.0",
  "private": true,
  "description": "Keel & Bell Bellroll: rent-to-own school instrument rentals",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run typecheck && rm -rf dist && npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/main.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --loader:.woff2=file --asset-names=fonts/[name] --outdir=dist/public && cp src/client/index.html dist/public/index.html",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "0.460.0",
    "motion": "14.9.0",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
