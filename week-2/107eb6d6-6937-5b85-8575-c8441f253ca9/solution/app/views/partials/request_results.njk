{%- from "macros.njk" import truck_art, label -%}
<div id="request-results" class="results">
{% if rows.length %}
  <table class="table table-cards">
    <caption class="sr-only">Logistics requests, newest first</caption>
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Tour</th>
        {% if can.dispatch %}<th scope="col">Requester</th>{% endif %}
        <th scope="col">Type</th>
        <th scope="col">Trucks</th>
        <th scope="col">First show</th>
        <th scope="col">Status</th>
        <th scope="col">Submitted</th>
      </tr>
    </thead>
    <tbody id="request-rows">{% include "partials/request_rows.njk" %}</tbody>
  </table>
  {% include "partials/more.njk" %}
{% else %}
  <div class="empty">
    {{ truck_art('well-empty') }}
    <div class="empty-copy">
    {% if q %}
      <p class="list-text">No requests match "{{ q }}".</p>
      <button type="button" class="btn btn-secondary" data-clear-search>{{ label('Clear search') }}</button>
    {% elif status %}
      <p class="list-text">No {{ LABELS.status[status] }} requests yet.</p>
    {% else %}
      <p class="list-text">No requests yet.</p>
      {% if not can.dispatch %}<p class="muted">Choose New request to ask for trucks for your next run.</p>{% endif %}
    {% endif %}
    </div>
  </div>
{% endif %}
</div>
