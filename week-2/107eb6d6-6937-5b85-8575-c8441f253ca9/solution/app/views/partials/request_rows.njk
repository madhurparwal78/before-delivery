{%- from "macros.njk" import chip -%}
{%- for r in rows %}
<tr data-request-id="{{ r.id }}" data-status="{{ r.status }}"{% if appended %} class="is-new"{% endif %}>
  <td data-label="ID" class="mono">{{ r.id }}</td>
  <td data-label="Tour" class="cell-tour"><a href="/requests/{{ r.id }}" title="{{ r.tour_name }}"{% if appended and loop.first %} data-focus-first{% endif %}>{{ r.tour_name }}</a></td>
  {% if can.dispatch %}<td data-label="Requester" class="cell-nowrap">{{ r.requester.name }}</td>{% endif %}
  <td data-label="Type">{{ LABELS.type[r.transport_type] }}</td>
  <td data-label="Trucks">{{ r.trucks_assigned }} of {{ r.trucks_requested }}</td>
  <td data-label="First show">{{ (r.first_show_date | day) or 'No date' }}</td>
  <td data-label="Status">{{ chip(r.status) }}</td>
  <td data-label="Submitted">{{ r.created_at | day }}</td>
</tr>
{%- endfor %}
