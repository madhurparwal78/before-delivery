{
  "name": "tinework",
  "version": "1.0.0",
  "private": true,
  "description": "Tinework: a public gallery of parametric 3D parts written in Tine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "ioredis": "5.4.1",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
