{
  "name": "ourlet-consignment-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.mjs && esbuild src/client/main.tsx --bundle --minify --format=esm --jsx=automatic --target=chrome120 --outfile=dist/client/app.js",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "0.553.0",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "wasm-feature-detect": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
