{
  "name": "ashlar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ashlar: a browser playground for small HTML, CSS and JavaScript pens with exact versions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "acorn": "8.19.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
