{
  "name": "plinth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plinth by Oarlock Works: a collaborative visual website builder.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --outfile=dist/public/assets/app.js --jsx=automatic",
    "build:static": "rm -rf dist/public/fonts && mkdir -p dist/public && cp -r public/fonts dist/public/fonts",
    "build": "npm run typecheck && npm run build:server && npm run build:client && npm run build:static",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
