{
  "name": "highwater-unit-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Orrin & Vale Developments Highwater Unit Finder",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && node tools/bundle.mjs",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "assets": "tsx tools/generate-seed-assets.ts"
  },
  "dependencies": {
    "lucide-react": "1.67.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource/red-hat-display": "5.3.0",
    "@fontsource/red-hat-text": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "draco3dgltf": "1.5.9",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
