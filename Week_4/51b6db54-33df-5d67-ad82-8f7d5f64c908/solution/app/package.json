{
  "name": "celmate",
  "version": "1.0.0",
  "private": true,
  "description": "Celmate: a shared pixel-sprite workspace",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "omggif": "1.0.10",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
