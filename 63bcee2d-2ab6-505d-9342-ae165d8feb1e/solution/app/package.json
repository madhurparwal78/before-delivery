{
  "name": "plumbline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ${PLUMBLINE_OUT:-dist}/server && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node ${PLUMBLINE_OUT:-dist}/server/server/main.js"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "lucide-react": "0.460.0",
    "pg": "8.13.1",
    "pngjs": "7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "5.1.1",
    "@fontsource/instrument-serif": "5.1.1",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.3"
  }
}
