{
  "_schema": "run-manifest-v1",
  "install": "python3 -m venv --clear .venv && .venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -r requirements.txt",
  "build": "",
  "serve": ".venv/bin/python -m gunicorn --workers 3 --worker-class gthread --threads 4 --graceful-timeout 5 --bind 0.0.0.0:${APP_PUBLIC_PORT:-4173} app:app"
}
