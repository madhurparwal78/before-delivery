<ol class="timeline">
  {% for e in entries %}
  <li class="entry entry-{{ e.kind }}" data-activity-kind="{{ e.kind }}">
    <span class="entry-dot" aria-hidden="true"></span>
    <p class="entry-time caption"><time datetime="{{ e.created_at }}">{{ e.created_at | stamp }}</time></p>
    {% if e.kind == 'confirmed' or e.kind == 'declined' %}
    <p class="entry-line"><strong>{{ LABELS.status[e.kind] }} by {{ e.actor.name }}</strong></p>
    <p class="entry-note wrap">{{ e.note }}</p>
    {% else %}
    <p class="entry-line"><strong>{{ e.note }}</strong></p>
    <p class="entry-note muted">by {{ e.actor.name }}</p>
    {% endif %}
  </li>
  {% endfor %}
</ol>
