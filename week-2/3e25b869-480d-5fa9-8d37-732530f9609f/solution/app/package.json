{
  "name": "loafline",
  "version": "1.0.0",
  "private": true,
  "description": "Pain de Lune Loafline: drops, Trio subscriptions and the studio back room.",
  "type": "module",
  "exports": {
    ".": "./src/server/main.ts",
    "./client": "./src/client/main.tsx"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node build.config.mjs",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "pg": "8.16.3",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  }
}
