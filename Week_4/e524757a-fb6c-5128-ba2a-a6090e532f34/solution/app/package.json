{
  "name": "hushfoot",
  "version": "1.0.0",
  "private": true,
  "description": "Hushfoot: family wildlife photography across five invented islands.",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server && npm run build:static",
    "build:client": "esbuild client/main.ts --bundle --minify --target=es2022 --format=esm --outdir=dist/public/assets --entry-names=app --loader:.woff2=file --asset-names=[name]-[hash]",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:static": "cp public/index.html dist/public/index.html",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
