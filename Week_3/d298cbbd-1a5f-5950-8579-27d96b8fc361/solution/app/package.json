{
  "name": "strikeproof",
  "version": "1.0.0",
  "description": "Strikeproof: a typing-speed test whose every result is a proof.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:client": "esbuild client/main.tsx --bundle --minify --target=es2022 --outdir=dist/public/assets --entry-names=app --asset-names=[name]-[hash] --loader:.woff2=file --public-path=/assets && cp client/index.html dist/public/index.html",
    "build": "tsc --noEmit && rm -rf dist && npm run build:server && npm run build:client",
    "start": "node dist/server.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "pg": "8.23.1",
    "preact": "11.1.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module"
}
