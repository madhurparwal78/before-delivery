{
  "name": "fittings-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Holmgarth Aftercare Fittings Desk",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --target=es2022 --jsx=automatic --jsx-import-source=preact --external:/fonts/* --outfile=dist/public/assets/app.js",
    "build:assets": "mkdir -p dist/public && cp src/client/index.html dist/public/index.html && cp -R public/fonts dist/public/fonts",
    "build": "npm run typecheck && npm run build:server && npm run build:client && npm run build:assets",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "pg": "8.13.1",
    "preact": "10.25.4"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "esbuild": "0.24.2",
    "typescript": "5.7.3"
  }
}
