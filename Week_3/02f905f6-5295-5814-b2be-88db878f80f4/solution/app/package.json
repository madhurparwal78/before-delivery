{
  "name": "shelfmark",
  "version": "1.0.0",
  "private": true,
  "description": "Shelfmark, the firing desk for Brickfield Lane Clayhouse",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs --log-level=error",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --outdir=dist/public/assets --entry-names=app --asset-names=[name]-[hash] --loader:.woff2=file --loader:.woff=file --define:process.env.NODE_ENV=\\\"production\\\" --log-level=error",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
