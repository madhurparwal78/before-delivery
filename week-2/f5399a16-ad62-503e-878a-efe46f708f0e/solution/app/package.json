{
  "name": "clapstick",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:client": "esbuild src/client/main.tsx --bundle --minify --jsx=automatic --target=es2022 --define:process.env.NODE_ENV='\"production\"' --external:/assets/fonts/* --outfile=dist/assets/app.js",
    "serve": "node dist/server.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.24.2",
    "typescript": "5.7.3"
  }
}
