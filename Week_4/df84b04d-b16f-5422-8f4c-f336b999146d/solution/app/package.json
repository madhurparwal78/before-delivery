{
  "name": "twigline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Twigline: a web outliner with zoom, mirrors and single-branch sharing.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:client": "vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build/server.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node build/server.js"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
