{
  "name": "twinrow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Twinrow: a shared workspace for knitting and crochet charts",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server/main.js",
    "build:client": "vite build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "ioredis": "5.11.1",
    "lucide-react": "0.577.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
